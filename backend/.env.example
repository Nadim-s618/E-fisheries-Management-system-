SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL settings. The app always uses the database named "efisheries_db".
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Weather uses OpenWeather. Create a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
OPENWEATHER_TIMEOUT_SECONDS=8
OPENWEATHER_GEOCODING_COUNTRY_CODE=BD
WEATHER_REPORT_CACHE_MINUTES=30

# Gemini powers AI recommendations. Create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=12

# Supabase Storage (S3-compatible) for uploaded images
SUPABASE_STORAGE_BUCKET=media
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your-supabase-region
SUPABASE_S3_PUBLIC_DOMAIN=your-project-ref.supabase.co/storage/v1/object/public/media
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
